{
  "name": "tax-document-renamer-v4",
  "version": "4.0.0",
  "description": "税務書類自動リネーム・振り分けシステム v4.0 - README仕様完全準拠版",
  "main": "tax-renamer-v4.js",
  "author": "Tax Document Renamer Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "test": "node test-v4.js"
  },
  "build": {
    "appId": "com.taxrenamer.v4",
    "productName": "税務書類リネーマー v4.0",
    "directories": {
      "output": "dist-v4"
    },
    "files": [
      "tax-renamer-v4.js",
      "preload-v4.js",
      "税務書類リネーマーv4.html",
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable", 
          "arch": ["x64"]
        }
      ],
      "artifactName": "税務書類リネーマーv4.0.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraFiles": [
      {
        "from": "node_modules/electron/dist",
        "to": ".",
        "filter": ["ffmpeg.dll", "libEGL.dll", "libGLESv2.dll", "d3dcompiler_47.dll"]
      }
    ]
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "pdf-parse": "^1.1.1",
    "chokidar": "^3.5.3"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  }
}