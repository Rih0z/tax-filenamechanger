{
  "appId": "com.rih0z.tax-filenamechanger",
  "productName": "税務書類リネーマー",
  "directories": {
    "output": "dist-portable"
  },
  "files": [
    "dist/**/*",
    "resources/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "win": {
    "target": "portable",
    "icon": "resources/icon.ico"
  },
  "portable": {
    "artifactName": "税務書類リネーマー.exe",
    "requestExecutionLevel": "user",
    "unpackDirName": false
  },
  "extraResources": [
    {
      "from": "node_modules/electron/dist",
      "to": ".",
      "filter": ["*.dll"]
    }
  ],
  "compression": "maximum",
  "nsis": null
}